# Cross between populations A and B at generation 6
F1Cross <- TwoPopCross(map = map, populationSim_A = popA$Haplotype[2401:3000, ],
populationSim_B = popB$Haplotype[2401:3000, ], nSireA = 20,
nDamA = 100, nSireB = 40, nDamB = 100, Sire_From = "B",
mutationRate = 2.5 * 10^-5, SelType = "TBV",h2 = 0.3,
trait_mean = 15, VarE_PopA = VarEA, VarE_PopB = VarEA,
Effect_PopA = Effect, Effect_PopB = Effect, IndStartVal = 1,
prefixID = "F1C", nProgeny = 300, recL = 5,
nChr = 5, minLength = 0)
# Intercrossing of AB population for generation 7 to 10
FAB <-  GenOnePopulation(ngenerations = 4, map = map, populationSim = F1Cross$Haplotype,
nSire = 40,nDam = 100,mutationRate = 2.5 * 10^-5, SelType = "TBV",
h2 = 0.3, trait_mean = 20, VarE = VarEA, Effect = Effect,
recL = 5, nChr = 5, minLength = 0, IndStartVal = 1,
prefixID = "AB_AN", nProgeny = 300)
# Haplotype information from the crossbred animals
DataHap_admix <- FAB$Haplotype
dim(DataHap_admix)
DataHap_admix[1:10, 1:10]
# Estimation of true breed composition from coded haplotype
TBC_RealDat <- trueBreedComp(DataHap_admix[1:100, ])
# Arrange the population
TBC_data = TBC_RealDat[c(2,1), ]
# Admixture plot
Admixplot(trueBC = TBC_data,
color = c("#CC79A7", "#0072B2"),
legendlabels = c("ABR", "ANG"))
# Haplotype information of crossbred animals
HaploSubDat <- DataHap_admix[1:100, ]
HaploSubDat[1:10, 1:10]
# Read map file
map <- fread("MAPQTL.txt")
# Haplotype plot
plotHaplo(Haplotype = HaploSubDat,
colors = c("#CC79A7", "#0072B2"),
map = map,
nChr = 5,
legendlabels = c("ABR", "ANG"))
pheno = Ext_Pheno(df = FAB$population)
head(pheno)
tail(pheno)
