h2 = 0.3, trait_mean = 30, VarE = 0.6 ,Effect = Effect,
recL = 10,nChr = 10, minLength = 350, IndStartVal=1,
prefixID = "B", nProgeny = 300)
# Simulation of a crossbred population derived from populations A and B
