library(desc)
tools::toTitleCase("Haplotype-Based Tracking of Admixed Population for Breed Composition Estimation")
library(desc)
tools::toTitleCase("Haplotype-Based Tracking of Admixed Population for Breed Composition Estimation")
d <- description$new()
# Update Title and Description fields only
d$set(Title = "Haplotype-Based Tracking of Admixed Population for Breed Composition Estimation")
d$set(Description = "Simulate populations and track haplotypes over generations to evaluate population admixture. The package supports customisable population parameters, including size, number of markers, mutation rates and recombination.")
d$write()
# Now reorder the DESCRIPTION file to place Authors@R after Version
desc_lines <- readLines("DESCRIPTION")
# Find key line indices
version_idx <- grep("^Version:", desc_lines)
authors_start <- grep("^Authors@R:", desc_lines)
# Find the end of Authors@R block (next field that starts with a capital letter)
authors_end <- authors_start
next_field_idx <- grep("^[A-Z]", desc_lines)[grep("^[A-Z]", desc_lines) > authors_start]
if (length(next_field_idx) > 0) {
authors_end <- next_field_idx[1] - 1
}
# Extract the Authors@R block
authors_block <- desc_lines[authors_start:authors_end]
# Remove Authors@R from its current position
desc_lines <- desc_lines[-c(authors_start:authors_end)]
# Recalculate version_idx after removal
version_idx <- grep("^Version:", desc_lines)
# Insert Authors@R after Version line
insert_position <- version_idx
desc_lines <- c(
desc_lines[1:insert_position],
authors_block,
desc_lines[(insert_position + 1):length(desc_lines)]
)
# Write back
writeLines(desc_lines, "DESCRIPTION")
cat("DESCRIPTION file updated successfully!\n")
