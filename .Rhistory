gc()
knitr::opts_chunk$set(
echo = TRUE,
collapse = TRUE,
comment = "#>"
)
library(HAPTRACE)
library(data.table)
options(scipen = 999)
set.seed(1)
# Importing haplotype
Haplotype <- readRDS("RealHapSimData.rds")
dim(Haplotype)
str(Haplotype)
Haplotype[1:10, 1:10]
# Reading map file
map <- fread("map.txt")
head(map)
# Making a subset of the main population into two populations (Population A and B)
Population_A <- Haplotype[1:106, ]
Population_B <- Haplotype[107:840, ]
# Generate QTL effect file
QTLeffect <- QTLeffects(n_QTL_Chr = 2,
nChr = 5,
len_Chr = 100,
effect_distribution = "gamma")
MarkerEffect <- mapQTLfile(map = map,
QTL = QTLeffect)
QTLeffect <- as.numeric(MarkerEffect$Effect)
# Rescaling the effect
QTLEffect <- Rescale(Haplotype = Haplotype,
Effect = QTLeffect,
Phenosd = 5,
h2 = 0.3)
Effect <- QTLEffect$QTLeffect
VarEA <- QTLEffect$ErrorVar
# Assigning Population ID to the Population A and B
Population_A <- PopulationID(Population = Population_A, PopCode = "P1")
Population_B <- PopulationID(Population = Population_B, PopCode = "P2")
# Recode haplotype into (-1 and 1) and (-2 and 2)
Population_A <- Recode_Haplotype(df = Population_A, popBase = 1)
Population_B <- Recode_Haplotype(df = Population_B, popBase = 2)
# Generating populations A and B for 5 generations
# Population A
popA <- GenOnePopulation(ngenerations = 5, map = map, populationSim = Population_A,
nSire = 10, nDam = 20, mutationRate = 2.5 * 10^-5, SelType = "TBV",
h2 = 0.3, trait_mean = 10, VarE = VarEA, Effect = Effect,
recL = 5, nChr = 5, minLength = 200, IndStartVal = 1,
prefixID = "ABR", nProgeny = 300)
# Population B
popB <- GenOnePopulation(ngenerations = 5, map = map, populationSim = Population_B,
nSire = 40, nDam = 80, mutationRate = 2.5 * 10^-5, SelType = "TBV",
h2 = 0.3, trait_mean = 20, VarE = VarEA, Effect = Effect,
recL = 5, nChr = 5, minLength = 200, IndStartVal = 1,
prefixID = "ANG", nProgeny = 300)
# Cross between populations A and B at generation 6
F1Cross <- TwoPopCross(map = map, populationSim_A = popA$Haplotype[2401:3000, ],
populationSim_B = popB$Haplotype[2401:3000, ], nSireA = 10,
nDamA = 100, nSireB = 40, nDamB = 100, Sire_From = "B",
mutationRate = 2.5 * 10^-5, SelType = "TBV",h2 = 0.3,
trait_mean = 15, VarE_PopA = VarEA, VarE_PopB = VarEA,
Effect_PopA = Effect, Effect_PopB = Effect, IndStartVal = 1,
prefixID = "F1C", nProgeny = 300, recL = 5,
nChr = 5, minLength = 200)
# Intercrossing of AB population for generation 7 to 10
FAB <-  GenOnePopulation(ngenerations = 4, map = map, populationSim = F1Cross$Haplotype,
nSire = 40,nDam = 100,mutationRate = 2.5 * 10^-5, SelType = "TBV",
h2 = 0.3, trait_mean = 20, VarE = VarEA, Effect = Effect,
recL = 5, nChr = 5, minLength = 200, IndStartVal = 1,
prefixID = "AB_AN", nProgeny = 300)
# Haplotype information from the crossbred animals
DataHap_admix <- FAB$Haplotype
dim(DataHap_admix)
DataHap_admix[1:10, 1:10]
# Estimation of true breed composition from coded haplotype
TBC_RealDat <- trueBreedComp(DataHap_admix[1:100, ])
# Arrange the population
TBC_data = TBC_RealDat[c(2,1), ]
# Admixture plot
Admixplot(trueBC = TBC_data,
color = c("#CC79A7", "#0072B2"),
legendlabels = c("ABR", "ANG"))
# Haplotype information of crossbred animals
HaploSubDat <- DataHap_admix[1:100, ]
HaploSubDat[1:10, 1:10]
# Read map file
map <- fread("MAPQTL.txt")
# Haplotype plot
plotHaplo(Haplotype = HaploSubDat,
colors = c("#CC79A7", "#0072B2"),
map = map,
nChr = 5,
legendlabels = c("ABR", "ANG"))
gc()
