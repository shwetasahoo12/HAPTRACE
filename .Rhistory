populationSim = F1Cross$Haplotype,
nSire = 20,nDam = 100,mutationRate = 2.5 * 10^-5,
SelType = "random",h2 = 0.3, trait_mean = 20,
VarE = 0.6, Effect = Effect, recL = 10,
nChr = 10, minLength = 350, IndStartVal = 1,
prefixID = "C2", nProgeny = 300)
