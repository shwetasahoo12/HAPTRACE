columnB = sample(1:ncol(Haplotype), mutationNumber, replace = TRUE)
# Combine columns into a matrix
mutation <- as.matrix(cbind(columnA, columnB))
matrix_value = c(0, 1)
## Haplotype
if (all(Haplotype %in% matrix_value)) {
Haplotype[mutation[, 1:2]] <- 1 - Haplotype[mutation[, 1:2]]
}
else{
## Coded haplotype
Haplotype[mutation[, 1:2]] <- Haplotype[mutation[, 1:2]] * (-1)
}
return(Haplotype)
}
